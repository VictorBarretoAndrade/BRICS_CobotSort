# Copy to .env and fill in. Never commit .env.
# Provider for the operator agent: mock (default, offline) or anthropic.
COBOTSORT_PROVIDER=mock
# Model used when COBOTSORT_PROVIDER=anthropic.
COBOTSORT_MODEL=claude-sonnet-5-5
# Optional. Without a key the agent falls back to the rule-based planner.
ANTHROPIC_API_KEY=
# Headless Linux only: egl or osmesa.
# MUJOCO_GL=egl
# Anthropic provider tuning: effort (low|medium|high) and server-side refusal fallbacks (1|0).
COBOTSORT_EFFORT=medium
COBOTSORT_SERVER_FALLBACK=1
# YOLO inference device in the cell (cpu by default; 0 = first GPU).
# COBOTSORT_YOLO_DEVICE=cpu
